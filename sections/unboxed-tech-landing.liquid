      "default": "Fair, Good and Like New all work properly."
    },
    {
      "type": "text",
      "id": "callout_text",
      "label": "Callout text",
      "default": "The difference is cosmetic. We keep grading clear so customers can choose the finish and price point that suits them best."
    },
    {
      "type": "text",
      "id": "callout_button_label",
      "label": "Callout button label",
      "default": "Compare condition grades"
    },
    {
      "type": "url",
      "id": "callout_button_link",
      "label": "Callout button link"
    },
    {
      "type": "range",
      "id": "padding_top",
