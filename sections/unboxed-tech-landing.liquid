    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Browse smartphones, tablets, laptops, gaming and smartwatches that have been tested, cleaned and listed with a clear Fair, Good or Like New cosmetic grade.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
