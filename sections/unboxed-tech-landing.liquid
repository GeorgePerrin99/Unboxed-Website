{%- liquid
  assign category_anchor = '#UnboxedTechRouteCategories-' | append: section.id
  assign primary_link = section.settings.primary_button_link

  if primary_link == blank
    assign primary_link = category_anchor
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.72 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.72 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<section id="UnboxedTechRoute-{{ section.id }}" class="ub-tech-route section" {{ section.shopify_attributes }}>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="ub-tech-route__hero">
      <div class="ub-tech-route__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ub-tech-route__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="ub-tech-route__heading">{{ section.settings.heading | escape }}</h1>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="ub-tech-route__intro rte">
            {{ section.settings.intro }}
          </div>
        {% endif %}

        <div class="ub-tech-route__actions">
          {% if section.settings.primary_button_label != blank %}
            <a class="ub-tech-route__button" href="{{ primary_link }}">{{ section.settings.primary_button_label | escape }}</a>
          {% endif %}

          {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}
            <a class="ub-tech-route__button ub-tech-route__button--secondary" href="{{ section.settings.secondary_button_link }}">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>

        <div class="ub-tech-route__pills" role="list">
          <span class="ub-tech-route__pill" role="listitem">Professionally tested</span>
          <span class="ub-tech-route__pill" role="listitem">Clearly condition graded</span>
          <span class="ub-tech-route__pill" role="listitem">Reset and ready to use</span>
          <span class="ub-tech-route__pill" role="listitem">Shop with confidence</span>
        </div>
      </div>

      <div class="ub-tech-route__hero-visual">
        <div class="ub-tech-route__hero-media">
          {% if section.settings.hero_image != blank %}
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1600, 1800',
                alt: section.settings.heading
            }}
          {% endif %}

          <div class="ub-tech-route__hero-badges">
            {% if section.settings.badge_one != blank %}
              <span class="ub-tech-route__hero-badge">{{ section.settings.badge_one | escape }}</span>
            {% endif %}
            {% if section.settings.badge_two != blank %}
              <span class="ub-tech-route__hero-badge">{{ section.settings.badge_two | escape }}</span>
            {% endif %}
          </div>

          <div class="ub-tech-route__hero-note">
            {% if section.settings.hero_note_title != blank %}
              <p class="ub-tech-route__hero-note-title">{{ section.settings.hero_note_title | escape }}</p>
            {% endif %}

            {% if section.settings.hero_note_items != blank %}
              <ul class="ub-tech-route__hero-note-list">
                {% assign note_items = section.settings.hero_note_items | newline_to_br | split: '<br />' %}
                {% for note_item in note_items %}
                  {% assign note_text = note_item | strip %}
                  {% if note_text != blank %}
                    <li>{{ note_text | escape }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div id="UnboxedTechRouteCategories-{{ section.id }}" class="ub-tech-route__categories">
      <div class="ub-tech-route__section-head">
        {% if section.settings.categories_eyebrow != blank %}
          <p class="ub-tech-route__section-eyebrow">{{ section.settings.categories_eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.categories_heading != blank %}
          <h2 class="ub-tech-route__section-title">{{ section.settings.categories_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.categories_copy != blank %}
          <div class="ub-tech-route__section-copy rte">
            {{ section.settings.categories_copy }}
          </div>
        {% endif %}
      </div>

      <div class="ub-tech-route__category-grid" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'category' %}
            <article class="ub-tech-route__category-card" role="listitem" {{ block.shopify_attributes }}>
              <div class="ub-tech-route__category-media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 960, 1200',
                      alt: block.settings.title
                  }}
                {% endif %}
              </div>

              <div class="ub-tech-route__category-body">
                {% if block.settings.title != blank %}
                  <h3 class="ub-tech-route__category-title">{{ block.settings.title | escape }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="ub-tech-route__category-text">{{ block.settings.text | escape }}</p>
                {% endif %}

                {% if block.settings.link != blank %}
                  <a class="ub-tech-route__category-link" href="{{ block.settings.link }}">
                    {% if block.settings.link_label != blank %}
                      {{ block.settings.link_label | escape }}
                    {% else %}
                      Shop now
                    {% endif %}
                    <span aria-hidden="true">-></span>
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ub-tech-route__callout">
      <div class="ub-tech-route__callout-copy">
        {% if section.settings.callout_eyebrow != blank %}
          <p class="ub-tech-route__section-eyebrow">{{ section.settings.callout_eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.callout_heading != blank %}
          <h2 class="ub-tech-route__callout-title">{{ section.settings.callout_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.callout_text != blank %}
          <p class="ub-tech-route__callout-text">{{ section.settings.callout_text | escape }}</p>
        {% endif %}
      </div>

      {% if section.settings.callout_button_label != blank and section.settings.callout_button_link != blank %}
        <a class="ub-tech-route__button" href="{{ section.settings.callout_button_link }}">
          {{ section.settings.callout_button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .ub-tech-route {
    background: #ffffff;
    color: #111111;
  }

  .ub-tech-route__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }

  .ub-tech-route__eyebrow,
  .ub-tech-route__section-eyebrow {
    margin: 0 0 1.2rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #4b5563;
  }

  .ub-tech-route__heading {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3.8rem, 6vw, 7.4rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .ub-tech-route__intro {
    margin-top: 2.2rem;
    max-width: 62rem;
    font-size: 1.85rem;
    line-height: 1.65;
    color: #27303f;
  }

  .ub-tech-route__intro p {
    margin: 0;
  }

  .ub-tech-route__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.8rem;
  }

  .ub-tech-route__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 0 2.2rem;
    border-radius: 999px;
    border: 1px solid #111111;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.18s ease, opacity 0.18s ease, background 0.18s ease, color 0.18s ease;
  }

  .ub-tech-route__button:hover {
    transform: translateY(-1px);
    opacity: 0.94;
  }

  .ub-tech-route__button--secondary {
    background: transparent;
    color: #111111;
  }

  .ub-tech-route__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  .ub-tech-route__pill {
    display: inline-flex;
    align-items: center;
    min-height: 3.8rem;
    padding: 0.8rem 1.4rem;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 999px;
    background: #f8f7f3;
    color: #27303f;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .ub-tech-route__hero-media {
    position: relative;
    min-height: 58rem;
    border-radius: 3rem;
    overflow: hidden;
    background: linear-gradient(145deg, #f5f4ee 0%, #ece9df 100%);
    box-shadow: 0 24px 60px rgba(17, 17, 17, 0.09);
  }

  .ub-tech-route__hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ub-tech-route__hero-badges {
    position: absolute;
    top: 2.2rem;
    right: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: flex-end;
    max-width: 26rem;
  }

  .ub-tech-route__hero-badge {
    display: inline-flex;
    align-items: center;
    min-height: 3.6rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.86);
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  .ub-tech-route__hero-note {
    position: absolute;
    left: 2.2rem;
    right: 2.2rem;
    bottom: 2.2rem;
    max-width: 36rem;
    padding: 2rem 2.2rem;
    border-radius: 2.4rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 35px rgba(17, 17, 17, 0.08);
  }

  .ub-tech-route__hero-note-title {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4b5563;
  }

  .ub-tech-route__hero-note-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }

  .ub-tech-route__hero-note-list li {
    position: relative;
    padding-left: 1.8rem;
    color: #111111;
    font-size: 1.5rem;
    line-height: 1.45;
  }

  .ub-tech-route__hero-note-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: #111111;
  }

  .ub-tech-route__categories {
    margin-top: 7.2rem;
  }

  .ub-tech-route__section-head {
    max-width: 72rem;
    margin-bottom: 2.8rem;
  }

  .ub-tech-route__section-title,
  .ub-tech-route__callout-title {
    margin: 0;
    font-size: clamp(2.8rem, 4.2vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .ub-tech-route__section-copy {
    margin-top: 1.4rem;
    color: #4b5563;
    line-height: 1.7;
  }

  .ub-tech-route__section-copy p {
    margin: 0;
  }

  .ub-tech-route__category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 1.8rem;
  }

  .ub-tech-route__category-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 2.4rem;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 18px 36px rgba(17, 17, 17, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .ub-tech-route__category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 44px rgba(17, 17, 17, 0.08);
  }

  .ub-tech-route__category-media {
    aspect-ratio: 1 / 1;
    background: #f5f4ee;
  }

  .ub-tech-route__category-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ub-tech-route__category-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2rem;
  }

  .ub-tech-route__category-title {
    margin: 0;
    font-size: 2.2rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .ub-tech-route__category-text {
    margin: 0;
    color: #4b5563;
    line-height: 1.6;
  }

  .ub-tech-route__category-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: auto;
    color: #111111;
    font-weight: 600;
    text-decoration: none;
  }

  .ub-tech-route__callout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    margin-top: 5.2rem;
    padding: 2.6rem 2.8rem;
    border-radius: 2.8rem;
    background: linear-gradient(135deg, #f5f4ee 0%, #f1efe6 100%);
    border: 1px solid rgba(17, 17, 17, 0.08);
  }

  .ub-tech-route__callout-text {
    margin: 1.2rem 0 0;
    max-width: 62rem;
    color: #4b5563;
    line-height: 1.65;
  }

  @media screen and (max-width: 1199px) {
    .ub-tech-route__hero {
      gap: 3rem;
    }

    .ub-tech-route__hero-media {
      min-height: 50rem;
    }
  }

  @media screen and (max-width: 989px) {
    .ub-tech-route__hero {
      grid-template-columns: 1fr;
    }

    .ub-tech-route__heading {
      max-width: 100%;
    }

    .ub-tech-route__hero-media {
      min-height: 48rem;
    }

    .ub-tech-route__callout {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ub-tech-route__intro {
      font-size: 1.65rem;
      line-height: 1.6;
    }

    .ub-tech-route__hero-media {
      min-height: 38rem;
      border-radius: 2.4rem;
    }

    .ub-tech-route__hero-badges {
      position: static;
      padding: 1.6rem 1.6rem 0;
      max-width: none;
      justify-content: flex-start;
    }

    .ub-tech-route__hero-note {
      position: static;
      max-width: none;
      margin: 1.6rem;
      padding: 1.8rem;
    }

    .ub-tech-route__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .ub-tech-route__button {
      width: 100%;
    }

    .ub-tech-route__category-body {
      padding: 1.8rem;
    }

    .ub-tech-route__callout {
      padding: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Unboxed Tech Landing",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Refurbished tech"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop refurbished tech with clear condition grading"
