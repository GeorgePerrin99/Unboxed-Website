        font-size: 1.25rem;
      }

      .ub-refurbishment__item-chip {
        min-width: 15rem;
      }
    }
  </style>
  <script>
    (() => {
      const root = document.getElementById('UnboxedRefurb-{{ section.id }}');
      if (!root) return;

      const dataNode = root.querySelector('[data-refurb-data]');
      if (!dataNode) return;

      let payload;
      try {
        payload = JSON.parse(dataNode.textContent);
      } catch (error) {
        console.error('Unboxed refurbishment hub data could not be parsed.', error);
        return;
      }

      const items = Array.isArray(payload.items) ? payload.items : [];
      if (!items.length) return;

      const labels = {
        fair: 'Fair',
        good: 'Good',
        like_new: 'Like New'
      };

      const itemButtons = Array.from(root.querySelectorAll('[data-item-button]'));
      const conditionButtons = Array.from(root.querySelectorAll('[data-condition-button]'));
      const viewerCategory = root.querySelector('[data-viewer-category]');
      const viewerItem = root.querySelector('[data-viewer-item]');
      const viewerNote = root.querySelector('[data-viewer-note]');
      const viewerCondition = root.querySelector('[data-viewer-condition]');
      const viewerSummary = root.querySelector('[data-viewer-summary]');
      const viewerQualityNote = root.querySelector('[data-viewer-quality-note]');
      const viewerImageWrap = root.querySelector('[data-viewer-image-wrap]');
      const viewerImage = root.querySelector('[data-viewer-image]');
      const viewerPlaceholder = root.querySelector('[data-viewer-placeholder]');
      const aspectGrid = root.querySelector('[data-aspect-grid]');

      const state = {
        condition: root.dataset.initialCondition || payload.defaultCondition || 'good',
        itemId: root.dataset.initialItem || items[0].id
      };

      const getActiveItem = () => items.find(item => item.id === state.itemId) || items[0];

      const createAspectCard = (label, value) => {
        const card = document.createElement('article');
        card.className = 'ub-refurbishment__aspect-card';

        const labelNode = document.createElement('p');
        labelNode.className = 'ub-refurbishment__aspect-label';
        labelNode.textContent = label || 'Detail';

        const valueNode = document.createElement('p');
        valueNode.className = 'ub-refurbishment__aspect-text';
        valueNode.textContent = value || '';

        card.appendChild(labelNode);
        card.appendChild(valueNode);
        return card;
      };

      const syncButtonStates = activeItem => {
        itemButtons.forEach(button => {
          const isActive = button.dataset.itemId === activeItem.id;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        conditionButtons.forEach(button => {
          const isActive = button.dataset.condition === state.condition;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      };

      const render = () => {
        const activeItem = getActiveItem();
        if (!activeItem) return;

        state.itemId = activeItem.id;

        const activeCondition = activeItem.conditions[state.condition] || activeItem.conditions.good || activeItem.conditions.fair;
        const conditionImage = activeCondition && activeCondition.image ? activeCondition.image : activeItem.image;

        if (viewerCategory) viewerCategory.textContent = 'Refurbished tech';
        if (viewerItem) viewerItem.textContent = activeItem.label || '';
        if (viewerNote) viewerNote.textContent = payload.techExplorerNote || '';
        if (viewerCondition) viewerCondition.textContent = labels[state.condition] || 'Fair';
        if (viewerSummary) viewerSummary.textContent = activeCondition && activeCondition.summary ? activeCondition.summary : '';
        if (viewerQualityNote) viewerQualityNote.textContent = payload.techQualityNote || '';

        if (viewerImage && conditionImage) {
          viewerImage.src = conditionImage;
          viewerImage.alt = activeItem.label || '';
          viewerImage.hidden = false;
          if (viewerPlaceholder) viewerPlaceholder.hidden = true;
          if (viewerImageWrap) viewerImageWrap.classList.remove('is-empty');
        } else if (viewerImage) {
          viewerImage.hidden = true;
          if (viewerPlaceholder) viewerPlaceholder.hidden = false;
          if (viewerImageWrap) viewerImageWrap.classList.add('is-empty');
        }

        if (aspectGrid) {
          aspectGrid.innerHTML = '';
          (activeItem.aspects || []).forEach(aspect => {
            const value = aspect ? aspect[state.condition] : '';
            if (!aspect || (!aspect.label && !value)) return;
            aspectGrid.appendChild(createAspectCard(aspect.label, value));
          });
        }

        syncButtonStates(activeItem);
      };

      itemButtons.forEach(button => {
        button.addEventListener('click', () => {
          state.itemId = button.dataset.itemId;
          render();
        });
      });

      conditionButtons.forEach(button => {
        button.addEventListener('click', () => {
          state.condition = button.dataset.condition;
          render();
        });
      });

      render();
    })();
  </script>
</section>

