{% liquid
  assign default_condition = section.settings.default_condition
  assign initial_item = blank
  assign initial_label = ''
  assign initial_summary = ''
  assign initial_category_name = 'Refurbished tech'
  assign initial_explorer_note = section.settings.tech_explorer_note
  assign initial_quality_note = section.settings.tech_quality_note
  assign initial_condition_label = 'Fair'
  assign initial_image = ''
  assign aspect_1_value = ''
  assign aspect_2_value = ''
  assign aspect_3_value = ''
  assign aspect_4_value = ''

  for block in section.blocks
    if block.type == 'item' and block.settings.category == 'tech' and initial_item == blank
      assign initial_item = block
    endif
  endfor

  if initial_item == blank
    for block in section.blocks
      if block.type == 'item' and block.settings.category == 'tech'
        assign initial_item = block
        break
      endif
    endfor
  endif

  if initial_item != blank
    assign initial_label = initial_item.settings.label
    assign initial_summary = initial_item.settings.fair_summary
    assign aspect_1_value = initial_item.settings.aspect_1_fair
    assign aspect_2_value = initial_item.settings.aspect_2_fair
    assign aspect_3_value = initial_item.settings.aspect_3_fair
    assign aspect_4_value = initial_item.settings.aspect_4_fair

    if default_condition == 'good'
      assign initial_summary = initial_item.settings.good_summary
      assign aspect_1_value = initial_item.settings.aspect_1_good
      assign aspect_2_value = initial_item.settings.aspect_2_good
      assign aspect_3_value = initial_item.settings.aspect_3_good
      assign aspect_4_value = initial_item.settings.aspect_4_good
      assign initial_condition_label = 'Good'
    elsif default_condition == 'like_new'
      assign initial_summary = initial_item.settings.like_new_summary
      assign aspect_1_value = initial_item.settings.aspect_1_like_new
      assign aspect_2_value = initial_item.settings.aspect_2_like_new
      assign aspect_3_value = initial_item.settings.aspect_3_like_new
      assign aspect_4_value = initial_item.settings.aspect_4_like_new
      assign initial_condition_label = 'Like New'
    endif

    if default_condition == 'good' and initial_item.settings.good_image != blank
      assign initial_image = initial_item.settings.good_image | image_url: width: 1600
    elsif default_condition == 'like_new' and initial_item.settings.like_new_image != blank
      assign initial_image = initial_item.settings.like_new_image | image_url: width: 1600
    elsif initial_item.settings.fair_image != blank
      assign initial_image = initial_item.settings.fair_image | image_url: width: 1600
    elsif initial_item.settings.display_image != blank
      assign initial_image = initial_item.settings.display_image | image_url: width: 1600
    elsif initial_item.settings.thumbnail != blank
      assign initial_image = initial_item.settings.thumbnail | image_url: width: 1600
    endif
  endif

%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<section
  id="UnboxedRefurb-{{ section.id }}"
  class="ub-refurbishment section color-{{ section.settings.color_scheme }} gradient"
  data-initial-condition="{{ default_condition }}"
  {% if initial_item != blank %}
    data-initial-item="{{ initial_item.id }}"
  {% endif %}
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="ub-refurbishment__hero">
      <div class="ub-refurbishment__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ub-refurbishment__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="ub-refurbishment__heading">{{ section.settings.heading | escape }}</h1>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="ub-refurbishment__intro rte">
            {{ section.settings.intro }}
          </div>
        {% endif %}

        <div class="ub-refurbishment__trust-list" role="list">
          <div class="ub-refurbishment__trust-pill" role="listitem">Professionally checked</div>
          <div class="ub-refurbishment__trust-pill" role="listitem">Individually assessed</div>
          <div class="ub-refurbishment__trust-pill" role="listitem">Ready for everyday use</div>
          <div class="ub-refurbishment__trust-pill" role="listitem">Shop with confidence</div>
        </div>
      </div>

      <div class="ub-refurbishment__hero-cards">
        <article class="ub-refurbishment__spotlight-card">
          <div class="ub-refurbishment__spotlight-media">
            {% if section.settings.tech_card_image != blank %}
              {{
                section.settings.tech_card_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200',
                  alt: section.settings.tech_card_heading
              }}
            {% endif %}
          </div>
          <div class="ub-refurbishment__spotlight-body">
            <p class="ub-refurbishment__spotlight-kicker">Refurbished tech</p>
            <h2 class="ub-refurbishment__spotlight-title">{{ section.settings.tech_card_heading | escape }}</h2>
            {% if section.settings.tech_card_text != blank %}
              <div class="ub-refurbishment__spotlight-text rte">
                {{ section.settings.tech_card_text }}
              </div>
            {% endif %}
            {% if section.settings.tech_card_link != blank and section.settings.tech_card_link_label != blank %}
              <a class="ub-refurbishment__spotlight-link" href="{{ section.settings.tech_card_link }}">
                {{ section.settings.tech_card_link_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>

        <article class="ub-refurbishment__spotlight-card">
          <div class="ub-refurbishment__spotlight-media">
            {% if section.settings.jewellery_card_image != blank %}
              {{
                section.settings.jewellery_card_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200',
                  alt: section.settings.jewellery_card_heading
              }}
            {% endif %}
          </div>
          <div class="ub-refurbishment__spotlight-body">
            <p class="ub-refurbishment__spotlight-kicker">Refurbished jewellery</p>
            <h2 class="ub-refurbishment__spotlight-title">{{ section.settings.jewellery_card_heading | escape }}</h2>
            {% if section.settings.jewellery_card_text != blank %}
              <div class="ub-refurbishment__spotlight-text rte">
                {{ section.settings.jewellery_card_text }}
              </div>
            {% endif %}
            {% if section.settings.jewellery_card_link != blank and section.settings.jewellery_card_link_label != blank %}
              <a class="ub-refurbishment__spotlight-link" href="{{ section.settings.jewellery_card_link }}">
                {{ section.settings.jewellery_card_link_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      </div>
    </div>

    <div class="ub-refurbishment__process">
      <div class="ub-refurbishment__section-head">
        {% if section.settings.process_heading != blank %}
          <h2 class="ub-refurbishment__section-title">{{ section.settings.process_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.process_copy != blank %}
          <div class="ub-refurbishment__section-copy rte">
            {{ section.settings.process_copy }}
          </div>
        {% endif %}
      </div>

      <div class="ub-refurbishment__process-grid">
        <article class="ub-refurbishment__lane">
          <div class="ub-refurbishment__lane-head">
            <p class="ub-refurbishment__lane-kicker">Refurbished tech</p>
            <h3 class="ub-refurbishment__lane-title">Tested from battery health to final setup</h3>
            <p class="ub-refurbishment__lane-copy">Phones, laptops and wearables go through detailed diagnostics, restoration and final QC before they go live.</p>
          </div>
          <div class="ub-refurbishment__steps" role="list">
            {% assign tech_step_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'step' and block.settings.category == 'tech' %}
                {% assign tech_step_index = tech_step_index | plus: 1 %}
                <article class="ub-refurbishment__step" role="listitem" {{ block.shopify_attributes }}>
                  <span class="ub-refurbishment__step-number">{{ tech_step_index }}</span>
                  <div class="ub-refurbishment__step-copy">
                    <h4>{{ block.settings.title | escape }}</h4>
                    <p>{{ block.settings.text | escape }}</p>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </article>

        <article class="ub-refurbishment__lane">
          <div class="ub-refurbishment__lane-head">
            <p class="ub-refurbishment__lane-kicker">Refurbished jewellery</p>
            <h3 class="ub-refurbishment__lane-title">Restored for presentation, security and peace of mind</h3>
            <p class="ub-refurbishment__lane-copy">Each piece is checked for authenticity, finish, structure and wearability before it is approved for sale.</p>
          </div>
          <div class="ub-refurbishment__steps" role="list">
            {% assign jewellery_step_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'step' and block.settings.category == 'jewellery' %}
                {% assign jewellery_step_index = jewellery_step_index | plus: 1 %}
                <article class="ub-refurbishment__step" role="listitem" {{ block.shopify_attributes }}>
                  <span class="ub-refurbishment__step-number">{{ jewellery_step_index }}</span>
                  <div class="ub-refurbishment__step-copy">
                    <h4>{{ block.settings.title | escape }}</h4>
                    <p>{{ block.settings.text | escape }}</p>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </article>
      </div>
    </div>

    <div id="compare-tech-grades" class="ub-refurbishment__explorer">
      <div class="ub-refurbishment__section-head ub-refurbishment__section-head--compact">
        {% if section.settings.explorer_heading != blank %}
          <h2 class="ub-refurbishment__section-title">{{ section.settings.explorer_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.explorer_copy != blank %}
          <div class="ub-refurbishment__section-copy rte">
            {{ section.settings.explorer_copy }}
          </div>
        {% endif %}
      </div>

      <div class="ub-refurbishment__explorer-shell">
        <div class="ub-refurbishment__explorer-intro">
          <div class="ub-refurbishment__explorer-note-card">
            <p class="ub-refurbishment__explorer-note-eyebrow">Tech condition guide</p>
            <p class="ub-refurbishment__explorer-note-text">{{ section.settings.tech_explorer_note | escape }}</p>
          </div>
          <div class="ub-refurbishment__explorer-note-card ub-refurbishment__explorer-note-card--soft">
            <p class="ub-refurbishment__explorer-note-eyebrow">Jewellery is one of one</p>
            <p class="ub-refurbishment__explorer-note-text">{{ section.settings.jewellery_one_of_one_text | escape }}</p>
          </div>
        </div>

        <div class="ub-refurbishment__toolbar">
          <div class="ub-refurbishment__toolbar-head">
            <p class="ub-refurbishment__toolbar-kicker">Refurbished tech</p>
            <h3 class="ub-refurbishment__toolbar-title">Compare finish across our graded tech categories</h3>
          </div>

          <div class="ub-refurbishment__toggle-group ub-refurbishment__toggle-group--conditions" role="group" aria-label="Condition grade">
            <button class="ub-refurbishment__toggle {% if default_condition == 'fair' %}is-active{% endif %}" type="button" data-condition-button data-condition="fair" aria-pressed="{% if default_condition == 'fair' %}true{% else %}false{% endif %}">Fair</button>
            <button class="ub-refurbishment__toggle {% if default_condition == 'good' %}is-active{% endif %}" type="button" data-condition-button data-condition="good" aria-pressed="{% if default_condition == 'good' %}true{% else %}false{% endif %}">Good</button>
            <button class="ub-refurbishment__toggle {% if default_condition == 'like_new' %}is-active{% endif %}" type="button" data-condition-button data-condition="like_new" aria-pressed="{% if default_condition == 'like_new' %}true{% else %}false{% endif %}">Like New</button>
          </div>
        </div>

        <div class="ub-refurbishment__item-rail" role="group" aria-label="Items to compare">
          {% for block in section.blocks %}
            {% if block.type == 'item' and block.settings.category == 'tech' %}
              {% assign item_thumb = '' %}
              {% if block.settings.thumbnail != blank %}
                {% assign item_thumb = block.settings.thumbnail | image_url: width: 240 %}
              {% elsif block.settings.display_image != blank %}
                {% assign item_thumb = block.settings.display_image | image_url: width: 240 %}
              {% endif %}
              <button
                class="ub-refurbishment__item-chip{% if initial_item != blank and block.id == initial_item.id %} is-active{% endif %}"
                type="button"
                data-item-button
                data-item-id="{{ block.id }}"
                aria-pressed="{% if initial_item != blank and block.id == initial_item.id %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="ub-refurbishment__item-thumb{% if item_thumb == '' %} is-empty{% endif %}">
                  {% if item_thumb != '' %}
                    <img src="{{ item_thumb }}" alt="" loading="lazy" width="72" height="72">
                  {% else %}
                    <span>{{ block.settings.label | slice: 0 }}</span>
                  {% endif %}
                </span>
                <span class="ub-refurbishment__item-label">{{ block.settings.label | escape }}</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>

        <div class="ub-refurbishment__viewer">
          <div class="ub-refurbishment__viewer-stage">
            <div class="ub-refurbishment__viewer-card">
              <div class="ub-refurbishment__viewer-copy">
                <p class="ub-refurbishment__viewer-kicker" data-viewer-category>{{ initial_category_name }}</p>
                <h3 class="ub-refurbishment__viewer-item" data-viewer-item>{{ initial_label | escape }}</h3>
                <p class="ub-refurbishment__viewer-note" data-viewer-note>{{ initial_explorer_note | escape }}</p>
              </div>

              <div class="ub-refurbishment__viewer-image-wrap{% if initial_image == '' %} is-empty{% endif %}" data-viewer-image-wrap>
                <img
                  {% if initial_image != '' %}
                    src="{{ initial_image }}"
                  {% endif %}
                  alt="{{ initial_label | escape }}"
                  loading="lazy"
                  width="960"
                  height="960"
                  data-viewer-image
                  {% if initial_image == '' %}
                    hidden
                  {% endif %}
                >
                <div class="ub-refurbishment__viewer-placeholder" data-viewer-placeholder {% if initial_image != '' %}hidden{% endif %}>
                  Preview image coming soon
                </div>
              </div>
            </div>
          </div>

          <div class="ub-refurbishment__viewer-panel">
            <div class="ub-refurbishment__summary-card">
              <p class="ub-refurbishment__condition-badge" data-viewer-condition>{{ initial_condition_label }}</p>
              <h3 class="ub-refurbishment__summary-title">What this condition looks like</h3>
              <p class="ub-refurbishment__summary-text" data-viewer-summary>{{ initial_summary | escape }}</p>
              <p class="ub-refurbishment__summary-note" data-viewer-quality-note>{{ initial_quality_note | escape }}</p>
            </div>

            <div class="ub-refurbishment__aspect-grid" data-aspect-grid>
              {% if initial_item != blank %}
                <article class="ub-refurbishment__aspect-card">
                  <p class="ub-refurbishment__aspect-label">{{ initial_item.settings.aspect_1_label | escape }}</p>
                  <p class="ub-refurbishment__aspect-text">{{ aspect_1_value | escape }}</p>
                </article>
                <article class="ub-refurbishment__aspect-card">
                  <p class="ub-refurbishment__aspect-label">{{ initial_item.settings.aspect_2_label | escape }}</p>
                  <p class="ub-refurbishment__aspect-text">{{ aspect_2_value | escape }}</p>
                </article>
                <article class="ub-refurbishment__aspect-card">
                  <p class="ub-refurbishment__aspect-label">{{ initial_item.settings.aspect_3_label | escape }}</p>
                  <p class="ub-refurbishment__aspect-text">{{ aspect_3_value | escape }}</p>
                </article>
                <article class="ub-refurbishment__aspect-card">
                  <p class="ub-refurbishment__aspect-label">{{ initial_item.settings.aspect_4_label | escape }}</p>
                  <p class="ub-refurbishment__aspect-text">{{ aspect_4_value | escape }}</p>
                </article>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-refurb-data>
    {
      "defaultCondition": {{ default_condition | json }},
      "techExplorerNote": {{ section.settings.tech_explorer_note | json }},
      "techQualityNote": {{ section.settings.tech_quality_note | json }},
      "items": [
        {% assign item_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'item' and block.settings.category == 'tech' %}
            {% assign thumb_src = '' %}
            {% assign display_src = '' %}
            {% assign fair_image_src = '' %}
            {% assign good_image_src = '' %}
            {% assign like_new_image_src = '' %}
            {% if block.settings.thumbnail != blank %}
              {% assign thumb_src = block.settings.thumbnail | image_url: width: 240 %}
            {% elsif block.settings.display_image != blank %}
              {% assign thumb_src = block.settings.display_image | image_url: width: 240 %}
            {% endif %}
            {% if block.settings.display_image != blank %}
              {% assign display_src = block.settings.display_image | image_url: width: 1600 %}
            {% elsif block.settings.thumbnail != blank %}
              {% assign display_src = block.settings.thumbnail | image_url: width: 1600 %}
            {% endif %}
            {% if block.settings.fair_image != blank %}
              {% assign fair_image_src = block.settings.fair_image | image_url: width: 1600 %}
            {% elsif display_src != '' %}
              {% assign fair_image_src = display_src %}
            {% endif %}
            {% if block.settings.good_image != blank %}
              {% assign good_image_src = block.settings.good_image | image_url: width: 1600 %}
            {% elsif display_src != '' %}
              {% assign good_image_src = display_src %}
            {% endif %}
            {% if block.settings.like_new_image != blank %}
              {% assign like_new_image_src = block.settings.like_new_image | image_url: width: 1600 %}
            {% elsif display_src != '' %}
              {% assign like_new_image_src = display_src %}
            {% endif %}
            {% if item_index > 0 %},{% endif %}
            {
              "id": {{ block.id | json }},
              "category": {{ block.settings.category | json }},
              "label": {{ block.settings.label | json }},
              "thumbnail": {{ thumb_src | json }},
              "image": {{ display_src | json }},
              "conditions": {
                "fair": {
                  "summary": {{ block.settings.fair_summary | json }},
                  "image": {{ fair_image_src | json }}
                },
                "good": {
                  "summary": {{ block.settings.good_summary | json }},
                  "image": {{ good_image_src | json }}
                },
                "like_new": {
                  "summary": {{ block.settings.like_new_summary | json }},
                  "image": {{ like_new_image_src | json }}
                }
              },
              "aspects": [
                {
                  "label": {{ block.settings.aspect_1_label | json }},
                  "fair": {{ block.settings.aspect_1_fair | json }},
                  "good": {{ block.settings.aspect_1_good | json }},
                  "like_new": {{ block.settings.aspect_1_like_new | json }}
                },
                {
                  "label": {{ block.settings.aspect_2_label | json }},
                  "fair": {{ block.settings.aspect_2_fair | json }},
                  "good": {{ block.settings.aspect_2_good | json }},
                  "like_new": {{ block.settings.aspect_2_like_new | json }}
                },
                {
                  "label": {{ block.settings.aspect_3_label | json }},
                  "fair": {{ block.settings.aspect_3_fair | json }},
                  "good": {{ block.settings.aspect_3_good | json }},
                  "like_new": {{ block.settings.aspect_3_like_new | json }}
                },
                {
                  "label": {{ block.settings.aspect_4_label | json }},
                  "fair": {{ block.settings.aspect_4_fair | json }},
                  "good": {{ block.settings.aspect_4_good | json }},
                  "like_new": {{ block.settings.aspect_4_like_new | json }}
                }
              ]
            }
            {% assign item_index = item_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>

  <style>
    .ub-refurbishment {
      overflow: clip;
    }

    .ub-refurbishment__hero,
    .ub-refurbishment__process,
    .ub-refurbishment__explorer {
      position: relative;
    }

    .ub-refurbishment__hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
      margin-bottom: 4rem;
    }

    .ub-refurbishment__eyebrow,
    .ub-refurbishment__spotlight-kicker,
    .ub-refurbishment__lane-kicker,
    .ub-refurbishment__viewer-kicker {
      margin: 0 0 0.9rem;
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(var(--color-foreground), 0.64);
    }

    .ub-refurbishment__heading {
      max-width: 13ch;
      margin: 0 0 1.4rem;
      line-height: 1.04;
      letter-spacing: -0.03em;
      font-size: clamp(3.2rem, 5vw, 5.8rem);
    }

    .ub-refurbishment__intro {
      max-width: 58rem;
      margin-bottom: 1.8rem;
      color: rgba(var(--color-foreground), 0.78);
    }

    .ub-refurbishment__intro p:last-child,
    .ub-refurbishment__spotlight-text p:last-child,
    .ub-refurbishment__section-copy p:last-child {
      margin-bottom: 0;
    }

    .ub-refurbishment__trust-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
    }

    .ub-refurbishment__trust-pill {
      padding: 0.9rem 1.2rem;
      border: 1px solid rgba(var(--color-foreground), 0.08);
      border-radius: 999px;
      background: rgba(var(--color-foreground), 0.03);
      font-size: 1.35rem;
      line-height: 1;
    }

    .ub-refurbishment__hero-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: 1.6rem;
      align-items: stretch;
    }

    .ub-refurbishment__spotlight-card,
    .ub-refurbishment__lane,
    .ub-refurbishment__explorer-shell {
      border: 1px solid rgba(var(--color-foreground), 0.08);
      border-radius: 2.4rem;
      background: rgb(var(--color-background));
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.06);
    }

    .ub-refurbishment__spotlight-card {
      overflow: hidden;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      height: 100%;
    }

    .ub-refurbishment__spotlight-media {
      aspect-ratio: 1 / 1;
      background:
        radial-gradient(circle at top right, rgba(var(--color-foreground), 0.07), transparent 42%),
        linear-gradient(180deg, rgba(var(--color-foreground), 0.02), rgba(var(--color-foreground), 0.04));
    }

    .ub-refurbishment__spotlight-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ub-refurbishment__spotlight-body {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 2rem;
    }

    .ub-refurbishment__spotlight-title {
      margin: 0 0 0.9rem;
      min-height: 3.5em;
      font-size: 2.2rem;
      line-height: 1.15;
    }

    .ub-refurbishment__spotlight-text {
      flex: 1 1 auto;
      color: rgba(var(--color-foreground), 0.76);
    }

    .ub-refurbishment__spotlight-link {
      display: inline-flex;
      align-items: center;
      margin-top: 1.2rem;
      font-weight: 700;
      text-decoration: none;
      color: inherit;
    }

    .ub-refurbishment__spotlight-link:hover {
      text-decoration: underline;
      text-underline-offset: 0.25rem;
    }

