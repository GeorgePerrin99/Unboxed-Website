{% comment %}
  Unboxed Condition Grades (Collection Page Version)
  - Visually distinct from Guarantee tiles (tinted bg + accent bar + badge + hover lift)
  - Strong CTA button to refurbishment/grading page
  - Grades: Like New / Good / Fair (defaults + preset)
{% endcomment %}

<section
  class="ub-condition section"
  style="
    --ub-bg: {{ section.settings.bg }};
    --ub-text: {{ section.settings.text }};
    --ub-muted: {{ section.settings.muted }};
    --ub-radius: {{ section.settings.radius }}px;
    --ub-pad: {{ section.settings.padding }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="ub-condition__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="ub-condition__sub">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    <div class="ub-condition__grid" role="list">
      {% for block in section.blocks %}
        {% assign title_lc = block.settings.title | downcase %}
        {% assign accent = '#111111' %}
        {% if title_lc contains 'like' %}
          {% assign accent = section.settings.accent_like_new %}
        {% elsif title_lc contains 'good' %}
          {% assign accent = section.settings.accent_good %}
        {% elsif title_lc contains 'fair' %}
          {% assign accent = section.settings.accent_fair %}
        {% endif %}

        <article class="ub-condition__card" style="--ub-accent: {{ accent }};" role="listitem" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="ub-condition__media">
              <img
                src="{{ block.settings.image | image_url: width: 1400 }}"
                alt=""
                loading="lazy"
                width="1200"
                height="900"
              >
            </div>
          {% endif %}

          <div class="ub-condition__body">
            <div class="ub-condition__badge">{{ section.settings.badge_text | escape }}</div>

            {% if block.settings.title != blank %}
              <h3 class="ub-condition__card-title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="ub-condition__card-text">{{ block.settings.text | escape }}</p>
            {% endif %}

            {% if block.settings.bullets != blank %}
              <ul class="ub-condition__bullets">
                {% assign lines = block.settings.bullets | newline_to_br | split: '<br />' %}
                {% for line in lines %}
                  {% assign item = line | strip %}
                  {% if item != blank %}
                    <li>{{ item | escape }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.link != blank and section.settings.link_label != blank %}
      <div class="ub-condition__cta">
        <a class="ub-condition__btn" href="{{ section.settings.link }}">
          {{ section.settings.link_label | escape }}
          <span class="ub-condition__arrow" aria-hidden="true">→</span>
        </a>
        {% if section.settings.link_note != blank %}
          <p class="ub-condition__note">{{ section.settings.link_note | escape }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .ub-condition{
    background: var(--ub-bg);
    color: var(--ub-text);
  }
  .ub-condition .page-width{
    padding-top: var(--ub-pad);
    padding-bottom: var(--ub-pad);
  }

  .ub-condition__title{
    margin: 0 0 8px;
    line-height: 1.2;
    text-align: center;
  }
  .ub-condition__sub{
    margin: 0 auto 34px;
    max-width: 760px;
    text-align: center;
    color: var(--ub-muted);
    line-height: 1.45;
  }

  .ub-condition__grid{
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 22px;
  }

  /* Card: pop + premium */
  .ub-condition__card{
    position: relative;
    border: 0;
    border-radius: calc(var(--ub-radius) + 8px);
    overflow: hidden;
    background: #fff;
    box-shadow: 0 12px 32px rgba(0,0,0,.08);
    transform: translateY(0);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  @media (min-width: 990px){
    .ub-condition__card:hover{
      transform: translateY(-4px);
      box-shadow: 0 18px 44px rgba(0,0,0,.12);
    }
  }

  /* Accent bar */
  .ub-condition__card::before{
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--ub-accent, #111);
    z-index: 2;
  }

  .ub-condition__media{
    aspect-ratio: 4 / 3;
    background: rgba(0,0,0,.03);
  }
  .ub-condition__media img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ub-condition__body{
    padding: 18px 18px 20px;
  }

  .ub-condition__badge{
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .02em;
    background: rgba(17,17,17,.06);
    color: #111;
    margin-bottom: 10px;
  }

  .ub-condition__card-title{
    margin: 0 0 6px;
    font-weight: 800;
    font-size: 1.45em;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .ub-condition__card-text{
    margin: 0 0 10px;
    color: var(--ub-muted);
    line-height: 1.45;
    font-size: .98em;
  }

  .ub-condition__bullets{
    margin: 0;
    padding-left: 18px;
    color: var(--ub-muted);
    line-height: 1.45;
    font-size: .95em;
  }
  .ub-condition__bullets li{
    margin: 7px 0;
  }
  .ub-condition__bullets li::marker{
    color: rgba(17,17,17,.55);
  }

  .ub-condition__cta{
    margin-top: 26px;
    text-align: center;
  }

  .ub-condition__btn{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: 999px;
    text-decoration: none;
    background: #111;
    color: #fff;
    font-weight: 600;
    box-shadow: 0 10px 22px rgba(0,0,0,.12);
    transform: translateY(0);
    transition: transform .18s ease, opacity .18s ease;
  }
  .ub-condition__btn:hover{
    opacity: .92;
    transform: translateY(-1px);
  }

  .ub-condition__note{
    margin: 10px 0 0;
    color: var(--ub-muted);
  }

  @media (max-width: 989px){
    .ub-condition__grid{
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
</style>

{% schema %}
{
  "name": "Unboxed Condition Grades",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Refurbished Condition Grades" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "All devices are fully tested and guaranteed to work perfectly. The only difference between grades is cosmetic appearance." },

    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Grade" },

    { "type": "color", "id": "bg", "label": "Background", "default": "#F7F7F7" },
    { "type": "color", "id": "text", "label": "Text colour", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#6B7280" },

    { "type": "color", "id": "accent_like_new", "label": "Accent: Like New", "default": "#16A34A" },
    { "type": "color", "id": "accent_good", "label": "Accent: Good", "default": "#2563EB" },
    { "type": "color", "id": "accent_fair", "label": "Accent: Fair", "default": "#F59E0B" },

    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 28, "step": 1, "default": 16 },
    { "type": "range", "id": "padding", "label": "Section padding", "min": 0, "max": 60, "step": 2, "default": 32 },

    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 3, "step": 1, "default": 1 },

    { "type": "url", "id": "link", "label": "CTA link" },
    { "type": "text", "id": "link_label", "label": "CTA label", "default": "View full grading guide" },
    { "type": "text", "id": "link_note", "label": "CTA helper text", "default": "See what’s included in testing, grading and warranty." }
  ],
  "blocks": [
    {
      "type": "grade",
      "name": "Condition grade",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Like New" },
        { "type": "text", "id": "text", "label": "Short description", "default": "Pristine condition with minimal to no signs of use." },
        { "type": "textarea", "id": "bullets", "label": "Bullet points (one per line)", "default": "No visible scratches or marks\nMay have very minor micro-scratches under direct light\nIdeal for gifts or premium use" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Unboxed Condition Grades",
      "blocks": [
        {
          "type": "grade",
          "settings": {
            "title": "Like New",
            "text": "Pristine condition with minimal to no signs of use.",
            "bullets": "No visible scratches or marks\nMay have very minor micro-scratches under direct light\nIdeal for gifts or premium use"
          }
        },
        {
          "type": "grade",
          "settings": {
            "title": "Good",
            "text": "Light signs of use, great balance of value and appearance.",
            "bullets": "Minor surface scratches or light scuffs\nScreen remains clear during use\nBest for everyday use"
          }
        },
        {
          "type": "grade",
          "settings": {
            "title": "Fair",
            "text": "Visible wear, fully functional and reliable.",
            "bullets": "Noticeable scratches, scuffs or small dents\nScreen may show light scratches but is fully usable\nGreat value for budget buyers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
