{%- liquid
  assign rating_sum = 0.0
  assign review_count = section.blocks.size

  for block in section.blocks
    assign rating_sum = rating_sum | plus: block.settings.star_rating
  endfor

  if review_count > 0
    assign average_times_ten = rating_sum | times: 10 | divided_by: review_count | round
    assign average_rating = average_times_ten | times: 0.1
  else
    assign average_rating = 0
  endif

  assign average_full_stars = average_rating | floor
  assign average_star_remainder = average_rating | minus: average_full_stars
  assign intro_title = section.settings.title | default: 'Customer reviews'
  assign intro_eyebrow = section.settings.eyebrow | default: 'Customer feedback'
  assign summary_label = section.settings.summary_label | default: 'Recent customer feedback'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .review-showcase-{{ section.id }} {
    --review-radius: 2.8rem;
    --review-border: rgba(18, 18, 18, 0.08);
    --review-surface: linear-gradient(180deg, #fbfbf8 0%, #eef2ef 100%);
    --review-card-surface: rgba(255, 255, 255, 0.92);
    --review-text-muted: rgba(18, 18, 18, 0.68);
    --review-star: #bf7f13;
    position: relative;
  }

  .review-showcase-{{ section.id }} .review-showcase__frame {
    background: var(--review-surface);
    border: 1px solid var(--review-border);
    border-radius: var(--review-radius);
    overflow: hidden;
    padding: clamp(2.2rem, 3vw, 3.8rem);
  }

  .review-showcase-{{ section.id }} .review-showcase__intro {
    align-items: start;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.7fr) minmax(24rem, 0.95fr);
    margin-bottom: clamp(2rem, 2.6vw, 3rem);
  }

  .review-showcase-{{ section.id }} .review-showcase__eyebrow {
    color: rgba(18, 18, 18, 0.62);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    line-height: 1.1;
    margin: 0 0 1.2rem;
    text-transform: uppercase;
  }

  .review-showcase-{{ section.id }} .review-showcase__title {
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0;
    max-width: 12ch;
  }

  .review-showcase-{{ section.id }} .review-showcase__description {
    color: var(--review-text-muted);
    line-height: 1.7;
    margin-top: 1.4rem;
    max-width: 58ch;
  }

  .review-showcase-{{ section.id }} .review-showcase__description p {
    margin: 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__summary {
    align-self: stretch;
    background: linear-gradient(180deg, #faf2e4 0%, #f2e4c8 100%);
    border: 1px solid rgba(145, 107, 62, 0.16);
    border-radius: 2.2rem;
    display: grid;
    gap: 1.1rem;
    padding: 2rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__summary-label {
    color: rgba(18, 18, 18, 0.56);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
  }

  .review-showcase-{{ section.id }} .review-showcase__summary-main {
    align-items: end;
    display: flex;
    gap: 1.2rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__score {
    font-size: clamp(3.8rem, 5vw, 5.6rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .review-showcase-{{ section.id }} .review-showcase__summary-copy {
    color: var(--review-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__summary-meta {
    color: rgba(18, 18, 18, 0.58);
    font-size: 1.3rem;
    line-height: 1.5;
    margin: 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__summary-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
  }

  .review-showcase-{{ section.id }} .review-showcase__source-pill {
    background: rgba(255, 255, 255, 0.56);
    border-radius: 999px;
    color: rgba(18, 18, 18, 0.72);
    display: inline-flex;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.9rem 1.2rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__stars {
    align-items: center;
    color: var(--review-star);
    display: inline-flex;
    gap: 0.2rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__stars svg {
    height: 1.6rem;
    width: 1.6rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__cards {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .review-showcase-{{ section.id }} .review-showcase__card {
    background: var(--review-card-surface);
    border: 1px solid rgba(18, 18, 18, 0.08);
    border-radius: 2.2rem;
    box-shadow: 0 1.8rem 4rem rgba(18, 18, 18, 0.04);
    display: grid;
    gap: 1.6rem;
    min-height: 100%;
    padding: 2rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__card--lead {
    grid-column: span 2;
    padding: 2.4rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__card-top {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .review-showcase-{{ section.id }} .review-showcase__tag {
    background: rgba(18, 18, 18, 0.05);
    border-radius: 999px;
    color: rgba(18, 18, 18, 0.68);
    display: inline-flex;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    max-width: 100%;
    overflow: hidden;
    padding: 0.9rem 1.1rem;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .review-showcase-{{ section.id }} .review-showcase__quote-wrap {
    display: grid;
    gap: 1rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__quote-icon {
    color: rgba(18, 18, 18, 0.14);
    width: 2.1rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__quote-icon svg {
    display: block;
    height: auto;
    width: 100%;
  }

  .review-showcase-{{ section.id }} .review-showcase__card-title {
    font-size: clamp(2rem, 2.2vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__quote {
    color: rgba(18, 18, 18, 0.82);
    font-size: 1.55rem;
    line-height: 1.75;
  }

  .review-showcase-{{ section.id }} .review-showcase__quote p {
    margin: 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__quote p + p {
    margin-top: 0.9rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__footer {
    align-items: center;
    display: flex;
    gap: 1.2rem;
    margin-top: auto;
  }

  .review-showcase-{{ section.id }} .review-showcase__avatar {
    align-items: center;
    background: linear-gradient(180deg, #ead5ae 0%, #d7b882 100%);
    border-radius: 50%;
    color: #3f2c0c;
    display: inline-flex;
    flex: 0 0 4.8rem;
    font-size: 1.45rem;
    font-weight: 700;
    height: 4.8rem;
    justify-content: center;
    overflow: hidden;
    width: 4.8rem;
  }

  .review-showcase-{{ section.id }} .review-showcase__avatar img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .review-showcase-{{ section.id }} .review-showcase__author {
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__meta {
    color: rgba(18, 18, 18, 0.58);
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0.2rem 0 0;
  }

  .review-showcase-{{ section.id }} .review-showcase__fallback-note {
    border: 1px dashed rgba(18, 18, 18, 0.12);
    border-radius: 2.2rem;
    color: rgba(18, 18, 18, 0.64);
    padding: 2rem;
    text-align: center;
  }

  @media screen and (max-width: 1100px) {
    .review-showcase-{{ section.id }} .review-showcase__intro {
      grid-template-columns: 1fr;
    }

    .review-showcase-{{ section.id }} .review-showcase__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .review-showcase-{{ section.id }} .review-showcase__card--lead {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
    }

    .review-showcase-{{ section.id }} {
      --review-radius: 2rem;
    }

    .review-showcase-{{ section.id }} .review-showcase__frame {
      padding: 1.8rem;
    }

    .review-showcase-{{ section.id }} .review-showcase__cards {
      grid-template-columns: 1fr;
    }

    .review-showcase-{{ section.id }} .review-showcase__card,
    .review-showcase-{{ section.id }} .review-showcase__card--lead {
      grid-column: 1 / -1;
      padding: 1.8rem;
    }

    .review-showcase-{{ section.id }} .review-showcase__summary {
      padding: 1.8rem;
    }

    .review-showcase-{{ section.id }} .review-showcase__summary-main {
      align-items: start;
      flex-direction: column;
      gap: 0.7rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <section
    class="review-showcase review-showcase-{{ section.id }}"
    data-review-showcase
    data-review-feed-url="{{ section.settings.review_feed_url | escape }}"
  >
    <div class="page-width">
      <div class="review-showcase__frame">
        <div class="review-showcase__intro">
          <div class="review-showcase__copy">
            <p class="review-showcase__eyebrow">{{ intro_eyebrow }}</p>
            <h2 class="review-showcase__title {{ section.settings.heading_size }}">{{ intro_title }}</h2>
            {%- if section.settings.description != blank -%}
              <div class="review-showcase__description rte">
                {{ section.settings.description }}
              </div>
            {%- endif -%}
          </div>

          <div class="review-showcase__summary">
            <p class="review-showcase__summary-label">{{ summary_label }}</p>

            <div class="review-showcase__summary-main">
              <span class="review-showcase__score" data-review-average>{{ average_rating }}</span>
              <div>
                <div class="review-showcase__stars" data-review-average-stars aria-label="{{ average_rating }} out of 5 stars">
                  {%- for i in (1..average_full_stars) -%}
                    {% render 'icon-star' %}
                  {%- endfor -%}
                  {%- if average_star_remainder != 0 -%}
                    {% render 'icon-halfstar' %}
                  {%- endif -%}
                </div>
                <p class="review-showcase__summary-copy">A cleaner view of recent customer comments on quality, condition and overall experience.</p>
              </div>
            </div>

            <p class="review-showcase__summary-meta" data-review-count>{{ review_count }} featured review{% if review_count != 1 %}s{% endif %}</p>

            <div class="review-showcase__summary-actions">
              <span class="review-showcase__source-pill">{{ section.settings.source_pill | default: 'Styled to fit your brand' }}</span>
              {%- if section.settings.review_link_label != blank and section.settings.review_link != blank -%}
                <a class="button button--secondary" href="{{ section.settings.review_link }}">{{ section.settings.review_link_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>

        <div class="review-showcase__cards" id="ReviewCards-{{ section.id }}" data-review-cards>
          {%- for block in section.blocks -%}
            {%- liquid
              assign author_name = block.settings.author | strip_html | strip
              assign initials = ''
              assign author_words = author_name | split: ' '

              for word in author_words limit: 2
                assign trimmed_word = word | strip
                if trimmed_word != blank
                  assign initial = trimmed_word | slice: 0, 1
                  assign initials = initials | append: initial
                endif
              endfor

              if initials == blank
                assign initials = 'U'
              endif
            -%}

            <article class="review-showcase__card{% if forloop.first %} review-showcase__card--lead{% endif %}" {{ block.shopify_attributes }}>
              <div class="review-showcase__card-top">
                <span class="review-showcase__tag">{{ block.settings.category | strip_html | default: section.settings.default_card_label | default: 'Customer review' }}</span>
                {%- if block.settings.display_review -%}
                  {%- liquid
                    assign card_full_stars = block.settings.star_rating | floor
                    assign card_star_remainder = block.settings.star_rating | minus: card_full_stars
                  -%}
                  <div class="review-showcase__stars" aria-label="{{ block.settings.star_rating }} out of 5 stars">
                    {%- for i in (1..card_full_stars) -%}
                      {% render 'icon-star' %}
                    {%- endfor -%}
                    {%- if card_star_remainder != 0 -%}
                      {% render 'icon-halfstar' %}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

              <div class="review-showcase__quote-wrap">
                <span class="review-showcase__quote-icon" aria-hidden="true">
                  {% render 'icon-quote' %}
                </span>
                {%- if block.settings.rev_title != blank -%}
                  <h3 class="review-showcase__card-title">{{ block.settings.rev_title }}</h3>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <div class="review-showcase__quote rte">{{ block.settings.quote }}</div>
                {%- endif -%}
              </div>

              <footer class="review-showcase__footer">
                <span class="review-showcase__avatar">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 120, height: 120, crop: 'center'
                      | image_tag: loading: 'lazy', widths: '60, 90, 120', alt: author_name
                    }}
                  {%- else -%}
                    {{ initials | upcase }}
                  {%- endif -%}
                </span>
                <div>
                  <p class="review-showcase__author">{{ author_name | default: 'Customer' }}</p>
                  {%- if block.settings.review_context != blank -%}
                    <p class="review-showcase__meta">{{ block.settings.review_context }}</p>
                  {%- endif -%}
                </div>
              </footer>
            </article>
          {%- endfor -%}

          {%- if section.blocks.size == 0 -%}
            <div class="review-showcase__fallback-note">
              Add customer reviews in the theme editor to start building this section.
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.querySelector('[data-review-showcase]');
    if (!root) return;

    const feedUrl = root.dataset.reviewFeedUrl;
    if (!feedUrl) return;

    const cardsTarget = root.querySelector('[data-review-cards]');
    const averageTarget = root.querySelector('[data-review-average]');
    const averageStarsTarget = root.querySelector('[data-review-average-stars]');
    const countTarget = root.querySelector('[data-review-count]');

    const escapeHtml = (value) =>
      String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const makeInitials = (name) => {
      const parts = String(name || 'Customer').trim().split(/\s+/).filter(Boolean).slice(0, 2);
      const initials = parts.map((part) => part.charAt(0)).join('');
      return initials || 'U';
    };

    const makeStars = (rating) => {
      const full = Math.floor(rating);
      const hasHalf = rating % 1 !== 0;
      let stars = '';

      for (let i = 0; i < full; i += 1) {
        stars += '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.93 4.8 17.52l.99-5.8-4.21-4.1 5.82-.85L10 1.5z" fill="currentColor"/></svg>';
      }

      if (hasHalf) {
        stars += '<svg viewBox="0 0 20 20" aria-hidden="true"><defs><linearGradient id="half-star"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="rgba(191,127,19,0.2)"/></linearGradient></defs><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.93 4.8 17.52l.99-5.8-4.21-4.1 5.82-.85L10 1.5z" fill="url(#half-star)"/></svg>';
      }

      return stars;
    };

    const formatDate = (rawDate) => {
      if (!rawDate) return '';
      const parsed = new Date(rawDate);
      if (Number.isNaN(parsed.getTime())) return '';
      return parsed.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
    };

    fetch(feedUrl)
      .then((response) => {
        if (!response.ok) throw new Error('Review feed request failed');
        return response.json();
      })
      .then((payload) => {
        const rawReviews = Array.isArray(payload)
          ? payload
          : Array.isArray(payload.reviews)
            ? payload.reviews
            : Array.isArray(payload.items)
              ? payload.items
              : [];

        const reviews = rawReviews
          .map((item) => {
            const rating = Number(item.stars ?? item.rating ?? item.star_rating ?? 0);
            const quote = item.text ?? item.quote ?? item.content ?? '';
            const author = item.consumer?.displayName ?? item.author ?? item.name ?? 'Customer';
            const meta = item.context ?? item.subtitle ?? item.consumer?.displayLocation ?? formatDate(item.createdAt ?? item.date);
            const tag = item.category ?? item.tag ?? item.productType ?? item.product_type ?? 'Customer review';

            if (!quote || !rating) return null;

            return {
              author,
              meta,
              quote,
              rating,
              tag,
              title: item.title ?? ''
            };
          })
          .filter(Boolean)
          .slice(0, 5);

        if (!reviews.length) return;

        const average = reviews.reduce((sum, item) => sum + item.rating, 0) / reviews.length;

        cardsTarget.innerHTML = reviews
          .map((review, index) => {
            return `
              <article class="review-showcase__card${index === 0 ? ' review-showcase__card--lead' : ''}">
                <div class="review-showcase__card-top">
                  <span class="review-showcase__tag">${escapeHtml(review.tag)}</span>
                  <div class="review-showcase__stars" aria-label="${escapeHtml(review.rating)} out of 5 stars">${makeStars(review.rating)}</div>
                </div>
                <div class="review-showcase__quote-wrap">
                  <span class="review-showcase__quote-icon" aria-hidden="true">
                    <svg viewBox="0 0 44 34"><path d="M0 20.67C0 8.84 8.03 0 18.34 0l1.72 6.51c-6.32 0-10.16 4.41-10.16 10.05h9.88V34H0V20.67Zm24.66 0C24.66 8.84 32.69 0 43 0l1 6.51c-6.32 0-9.44 4.41-9.44 10.05h9.44V34H24.66V20.67Z" fill="currentColor"/></svg>
                  </span>
                  ${review.title ? `<h3 class="review-showcase__card-title">${escapeHtml(review.title)}</h3>` : ''}
                  <div class="review-showcase__quote"><p>${escapeHtml(review.quote)}</p></div>
                </div>
                <footer class="review-showcase__footer">
                  <span class="review-showcase__avatar">${escapeHtml(makeInitials(review.author))}</span>
                  <div>
                    <p class="review-showcase__author">${escapeHtml(review.author)}</p>
                    ${review.meta ? `<p class="review-showcase__meta">${escapeHtml(review.meta)}</p>` : ''}
                  </div>
                </footer>
              </article>
            `;
          })
          .join('');

        if (averageTarget) {
          averageTarget.textContent = average.toFixed(1);
        }

        if (averageStarsTarget) {
          averageStarsTarget.innerHTML = makeStars(average);
          averageStarsTarget.setAttribute('aria-label', `${average.toFixed(1)} out of 5 stars`);
        }

        if (countTarget) {
          countTarget.textContent = `${reviews.length} featured reviews`;
        }
      })
      .catch(() => {
        /* Keep the theme-editor review blocks in place if the feed fails. */
      });
  })();
</script>

{% schema %}
{
  "name": "Review showcase",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer feedback"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Use this section to highlight recent customer feedback in a cleaner, more premium format.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "summary_label",
      "label": "Summary label",
      "default": "Recent customer feedback"
    },
    {
      "type": "text",
      "id": "source_pill",
      "label": "Summary pill",
      "default": "Styled to fit your brand"
    },
    {
      "type": "text",
      "id": "default_card_label",
      "label": "Default card label",
      "default": "Customer review"
    },
    {
      "type": "text",
      "id": "review_link_label",
      "label": "Review link label"
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Review link"
    },
    {
      "type": "url",
      "id": "review_feed_url",
      "label": "External review feed URL",
      "info": "Optional. Supports a JSON feed, including Trustpilot-style review objects delivered through your own feed or proxy."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        {
