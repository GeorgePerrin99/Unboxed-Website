{% doc %}
  @prompt
    Create a clean, premium-looking section for a refurbishment process page titled “Our 5-Stage Refurbishment Process”. The section should visually present five steps in a horizontal row on desktop and stacked cards on mobile. Each step should include a short title, a minimal icon, and a concise description. The five stages should be: 1) Intake & Identity Check – devices are logged, verified as genuine, checked against databases, and assessed for physical condition; 2) Full Diagnostic Testing – comprehensive hardware and software tests including battery health, screen, cameras, connectivity, sensors, and performance; 3) Repair & Restoration – faulty components replaced, firmware updated, and full functionality restored; 4) Professional Cleaning & Data Wipe – devices deep cleaned, sanitised, securely wiped of all previous data, and reset; 5) Final Quality Control – re-tested, visually inspected, assigned a condition grade, and approved for sale. The design should feel modern, trustworthy, and high-end with generous white space, subtle borders, and consistent icon styling. Include a short introductory paragraph explaining that only devices that pass every stage are listed for sale.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-refurb-process-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-refurb-process__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-refurb-process__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-refurb-process__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .ai-refurb-process__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-refurb-process__steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.step_gap }}px;
    margin-top: 40px;
  }

  .ai-refurb-process__step-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }

  .ai-refurb-process__step-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-refurb-process__step-number-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.card_padding }}px;
    left: {{ block.settings.card_padding }}px;
    width: 32px;
    height: 32px;
    background-color: {{ block.settings.number_background }};
    color: {{ block.settings.number_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-refurb-process__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 20px auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-refurb-process__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
  }

  .ai-refurb-process__step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-refurb-process__step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 1200px) {
    .ai-refurb-process__steps-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-refurb-process__steps-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-refurb-process__header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-refurb-process__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-refurb-process__intro-{{ ai_gen_id }} {
      font-size: {{ block.settings.intro_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<refurb-process-{{ ai_gen_id }} class="ai-refurb-process-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-refurb-process__container-{{ ai_gen_id }}">
    <div class="ai-refurb-process__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-refurb-process__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.intro_text != blank %}
        <div class="ai-refurb-process__intro-{{ ai_gen_id }}">{{ block.settings.intro_text }}</div>
      {% endif %}
    </div>

    <div class="ai-refurb-process__steps-{{ ai_gen_id }}">
      <div class="ai-refurb-process__step-{{ ai_gen_id }}">
        <div class="ai-refurb-process__step-number-{{ ai_gen_id }}">1</div>
        <div class="ai-refurb-process__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
            <rect x="9" y="3" width="6" height="4" rx="1"></rect>
            <path d="M9 12h6"></path>
            <path d="M9 16h6"></path>
          </svg>
        </div>
        <h3 class="ai-refurb-process__step-title-{{ ai_gen_id }}">{{ block.settings.step_1_title }}</h3>
        <p class="ai-refurb-process__step-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</p>
      </div>

      <div class="ai-refurb-process__step-{{ ai_gen_id }}">
        <div class="ai-refurb-process__step-number-{{ ai_gen_id }}">2</div>
        <div class="ai-refurb-process__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </div>
        <h3 class="ai-refurb-process__step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
        <p class="ai-refurb-process__step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</p>
      </div>

      <div class="ai-refurb-process__step-{{ ai_gen_id }}">
        <div class="ai-refurb-process__step-number-{{ ai_gen_id }}">3</div>
        <div class="ai-refurb-process__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
        </div>
        <h3 class="ai-refurb-process__step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
        <p class="ai-refurb-process__step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</p>
      </div>

      <div class="ai-refurb-process__step-{{ ai_gen_id }}">
        <div class="ai-refurb-process__step-number-{{ ai_gen_id }}">4</div>
        <div class="ai-refurb-process__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20"></path>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <h3 class="ai-refurb-process__step-title-{{ ai_gen_id }}">{{ block.settings.step_4_title }}</h3>
        <p class="ai-refurb-process__step-description-{{ ai_gen_id }}">{{ block.settings.step_4_description }}</p>
      </div>

      <div class="ai-refurb-process__step-{{ ai_gen_id }}">
        <div class="ai-refurb-process__step-number-{{ ai_gen_id }}">5</div>
        <div class="ai-refurb-process__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <h3 class="ai-refurb-process__step-title-{{ ai_gen_id }}">{{ block.settings.step_5_title }}</h3>
        <p class="ai-refurb-process__step-description-{{ ai_gen_id }}">{{ block.settings.step_5_description }}</p>
      </div>
    </div>
  </div>
</refurb-process-{{ ai_gen_id }}>

<script>
  (function() {
    class RefurbProcess{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.observeSteps();
      }

      observeSteps() {
        const steps = this.querySelectorAll('.ai-refurb-process__step-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.style.opacity = '1';
                  entry.target.style.transform = 'translateY(0)';
                }, index * 100);
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1
          });

          steps.forEach((step) => {
            step.style.opacity = '0';
            step.style.transform = 'translateY(20px)';
            step.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(step);
          });
        }
      }
    }

    customElements.define('refurb-process-{{ ai_gen_id }}', RefurbProcess{{ ai_gen_id }});
  })();
</script>

