{% doc %}
  @prompt
    is it possible to create a collage type layour for the mobile version only that would display pictures with writing over the top and buttons to go to specific pages or product collections? 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mobile-collage-{{ ai_gen_id }} {
    display: none;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-mobile-collage-{{ ai_gen_id }} {
      display: block;
      padding: {{ block.settings.mobile_padding }}px;
    }
  }

  .ai-mobile-collage-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.grid_gap }}px;
    {% if block.settings.layout == 'two-column' %}
      grid-template-columns: 1fr 1fr;
    {% elsif block.settings.layout == 'masonry' %}
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: minmax(150px, auto);
    {% else %}
      grid-template-columns: 1fr;
    {% endif %}
  }

  .ai-mobile-collage-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
    min-height: {{ block.settings.min_height }}px;
    {% if block.settings.layout == 'masonry' %}
      grid-row: span var(--ai-row-span-{{ ai_gen_id }});
    {% endif %}
  }

  .ai-mobile-collage-item-{{ ai_gen_id }}--large {
    {% if block.settings.layout == 'masonry' %}
      grid-column: span 2;
    {% endif %}
  }

  .ai-mobile-collage-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-mobile-collage-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-mobile-collage-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-mobile-collage-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-mobile-collage-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    z-index: 1;
  }

  .ai-mobile-collage-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ai-mobile-collage-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .ai-mobile-collage-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-mobile-collage-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-mobile-collage-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 12px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<mobile-collage-{{ ai_gen_id }}
  class="ai-mobile-collage-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-mobile-collage-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign item_image_key = 'item_' | append: i | append: '_image'
        assign item_title_key = 'item_' | append: i | append: '_title'
        assign item_description_key = 'item_' | append: i | append: '_description'
        assign item_button_text_key = 'item_' | append: i | append: '_button_text'
        assign item_link_key = 'item_' | append: i | append: '_link'
        assign item_size_key = 'item_' | append: i | append: '_size'
        assign item_row_span_key = 'item_' | append: i | append: '_row_span'

        assign item_enabled = block.settings[item_enabled_key]
        assign item_image = block.settings[item_image_key]
        assign item_title = block.settings[item_title_key]
        assign item_description = block.settings[item_description_key]
        assign item_button_text = block.settings[item_button_text_key]
        assign item_link = block.settings[item_link_key]
        assign item_size = block.settings[item_size_key]
        assign item_row_span = block.settings[item_row_span_key]
      %}

      {% if item_enabled %}
        <div
          class="ai-mobile-collage-item-{{ ai_gen_id }} {% if item_size == 'large' %}ai-mobile-collage-item-{{ ai_gen_id }}--large{% endif %}"
          style="--ai-row-span-{{ ai_gen_id }}: {{ item_row_span }};"
        >
          {% if item_image %}
            <img
              src="{{ item_image | image_url: width: 800 }}"
              alt="{{ item_image.alt | escape }}"
              loading="lazy"
              width="{{ item_image.width }}"
              height="{{ item_image.height }}"
              class="ai-mobile-collage-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-mobile-collage-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-mobile-collage-empty-state-{{ ai_gen_id }}">
                Add image {{ i }}
              </div>
            </div>
          {% endif %}

          <div class="ai-mobile-collage-overlay-{{ ai_gen_id }}"></div>

          <div class="ai-mobile-collage-content-{{ ai_gen_id }}">
            {% if item_title != blank %}
              <h3 class="ai-mobile-collage-title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}

            {% if item_description != blank %}
              <p class="ai-mobile-collage-description-{{ ai_gen_id }}">{{ item_description }}</p>
            {% endif %}

            {% if item_button_text != blank and item_link != blank %}
              <a
                href="{{ item_link }}"
                class="ai-mobile-collage-button-{{ ai_gen_id }}"
              >
                {{ item_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</mobile-collage-{{ ai_gen_id }}>

<script>
  (function() {
    class MobileCollage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('mobile-collage-{{ ai_gen_id }}', MobileCollage{{ ai_gen_id }});
  })();
</script>

