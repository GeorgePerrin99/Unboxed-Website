{% doc %}
  @prompt
    Create a premium, clean section titled “Our Condition Grades Explained” that matches this layout exactly: a centered H2 heading, a centered short paragraph beneath it that reads “All our refurbished products are fully functional and professionally tested. The only difference between grades is cosmetic appearance—performance is identical across all conditions.” Then show three equal-width cards in one row (Like New, Good, Fair) with generous whitespace, subtle light borders, rounded corners, and a soft shadow similar to the screenshot. Each card must include a large landscape image placeholder at the top with rounded corners, followed by the exact wording below. Card 1 title: “Like New”. Subtitle (italic): “Pristine condition with minimal to no signs of use”. Bullet list: “No visible scratches or marks on screen or body”, “May have very minor micro-scratches only visible under direct light”, “Perfect for those who want near-new aesthetics”, “Ideal for gifts or personal premium use”. Card 2 title: “Good”. Subtitle (italic): “Light signs of use with excellent overall appearance”. Bullet list: “Minor surface scratches or light scuffs on body”, “Screen is clear with no noticeable marks during use”, “Great balance of quality and value”, “Best for everyday use and practical buyers”. Card 3 title: “Fair”. Subtitle (italic): “Visible wear but fully functional and reliable”. Bullet list: “Noticeable scratches, scuffs, or dents on body”, “Screen may have light scratches but remains fully usable”, “Maximum value for budget-conscious buyers”, “Perfect for those prioritising function over appearance”. Keep the typography and spacing consistent with the existing page style (Veena theme), including blue bullet dots and the same general sizing/weight as in the screenshot. Now add image zoom functionality: wrap each card’s image in a container with overflow hidden and the same rounded corners, and on desktop hover smoothly zoom the image in place (CSS transform scale to about 1.25–1.35) with a subtle transition (e.g., 250–350ms ease), keeping layout fixed; change the cursor to zoom-in on hover. Only apply hover zoom on devices that support hover (use a hover media query) so mobile isn’t affected. On mobile, keep images static but allow tap to open the image larger in a simple lightbox/modal (no external libraries), with a close button and click-outside-to-close. Ensure images use object-fit: cover, fill the image area consistently, and use a high-res image render so zoom stays sharp. Include settings for each card’s image, but lock the text content to the exact wording above (do not paraphrase). No extra branding, no extra icons beyond the blue bullet style, and no text baked into the images.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-condition-grades-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
  }

  .ai-condition-grades__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-condition-grades__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-condition-grades__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 20px;
    color: {{ block.settings.heading_color }};
  }

  .ai-condition-grades__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-condition-grades__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-condition-grades__card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @media (hover: hover) {
    .ai-condition-grades__card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.5 }});
    }
  }

  .ai-condition-grades__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px {{ block.settings.card_border_radius }}px 0 0;
    background-color: #f4f4f4;
  }

  .ai-condition-grades__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .ai-condition-grades__image-wrapper-{{ ai_gen_id }}:hover .ai-condition-grades__image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.image_zoom_scale | divided_by: 10.0 }});
      cursor: zoom-in;
    }
  }

  .ai-condition-grades__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-condition-grades__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-condition-grades__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-condition-grades__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
  }

  .ai-condition-grades__card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    font-style: italic;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
  }

  .ai-condition-grades__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-condition-grades__list-item-{{ ai_gen_id }} {
    position: relative;
    padding-left: 24px;
    margin-bottom: 10px;
    font-size: {{ block.settings.list_item_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
  }

  .ai-condition-grades__list-item-{{ ai_gen_id }}:before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background-color: {{ block.settings.bullet_color }};
    border-radius: 50%;
  }

  .ai-condition-grades__list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-condition-grades__lightbox-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-condition-grades__lightbox-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-condition-grades__lightbox-content-{{ ai_gen_id }} {
    position: relative;
    max-width: 90%;
    max-height: 90%;
  }

  .ai-condition-grades__lightbox-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .ai-condition-grades__lightbox-close-{{ ai_gen_id }} {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 32px;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .ai-condition-grades__lightbox-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .ai-condition-grades__cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-condition-grades__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-condition-grades__intro-{{ ai_gen_id }} {
      font-size: {{ block.settings.intro_size | times: 0.9 }}px;
    }

    .ai-condition-grades__image-wrapper-{{ ai_gen_id }} {
      cursor: pointer;
    }
  }
{% endstyle %}

<condition-grades-{{ ai_gen_id }} class="ai-condition-grades-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-condition-grades__container-{{ ai_gen_id }}">
    <div class="ai-condition-grades__header-{{ ai_gen_id }}">
      <h2 class="ai-condition-grades__title-{{ ai_gen_id }}">Our Condition Grades Explained</h2>
      <p class="ai-condition-grades__intro-{{ ai_gen_id }}">
        All our refurbished products are fully functional and professionally tested. The only difference between grades is cosmetic appearance—performance is identical across all conditions.
      </p>
    </div>

    <div class="ai-condition-grades__cards-{{ ai_gen_id }}">
      <div class="ai-condition-grades__card-{{ ai_gen_id }}">
        <div class="ai-condition-grades__image-wrapper-{{ ai_gen_id }}" data-card="1">
          {% if block.settings.card_1_image %}
            <img
              src="{{ block.settings.card_1_image | image_url: width: 1200 }}"
              alt="Like New condition example"
              loading="lazy"
              width="1200"
              height="675"
              class="ai-condition-grades__image-{{ ai_gen_id }}"
              data-full-src="{{ block.settings.card_1_image | image_url: width: 2000 }}"
            >
          {% else %}
            <div class="ai-condition-grades__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-condition-grades__content-{{ ai_gen_id }}">
          <h3 class="ai-condition-grades__card-title-{{ ai_gen_id }}">Like New</h3>
          <p class="ai-condition-grades__card-subtitle-{{ ai_gen_id }}">Pristine condition with minimal to no signs of use</p>
          <ul class="ai-condition-grades__list-{{ ai_gen_id }}">
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">No visible scratches or marks on screen or body</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">May have very minor micro-scratches only visible under direct light</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Perfect for those who want near-new aesthetics</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Ideal for gifts or personal premium use</li>
          </ul>
        </div>
      </div>

      <div class="ai-condition-grades__card-{{ ai_gen_id }}">
        <div class="ai-condition-grades__image-wrapper-{{ ai_gen_id }}" data-card="2">
          {% if block.settings.card_2_image %}
            <img
              src="{{ block.settings.card_2_image | image_url: width: 1200 }}"
              alt="Good condition example"
              loading="lazy"
              width="1200"
              height="675"
              class="ai-condition-grades__image-{{ ai_gen_id }}"
              data-full-src="{{ block.settings.card_2_image | image_url: width: 2000 }}"
            >
          {% else %}
            <div class="ai-condition-grades__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-2' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-condition-grades__content-{{ ai_gen_id }}">
          <h3 class="ai-condition-grades__card-title-{{ ai_gen_id }}">Good</h3>
          <p class="ai-condition-grades__card-subtitle-{{ ai_gen_id }}">Light signs of use with excellent overall appearance</p>
          <ul class="ai-condition-grades__list-{{ ai_gen_id }}">
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Minor surface scratches or light scuffs on body</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Screen is clear with no noticeable marks during use</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Great balance of quality and value</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Best for everyday use and practical buyers</li>
          </ul>
        </div>
      </div>

      <div class="ai-condition-grades__card-{{ ai_gen_id }}">
        <div class="ai-condition-grades__image-wrapper-{{ ai_gen_id }}" data-card="3">
          {% if block.settings.card_3_image %}
            <img
              src="{{ block.settings.card_3_image | image_url: width: 1200 }}"
              alt="Fair condition example"
              loading="lazy"
              width="1200"
              height="675"
              class="ai-condition-grades__image-{{ ai_gen_id }}"
              data-full-src="{{ block.settings.card_3_image | image_url: width: 2000 }}"
            >
          {% else %}
            <div class="ai-condition-grades__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-3' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-condition-grades__content-{{ ai_gen_id }}">
          <h3 class="ai-condition-grades__card-title-{{ ai_gen_id }}">Fair</h3>
          <p class="ai-condition-grades__card-subtitle-{{ ai_gen_id }}">Visible wear but fully functional and reliable</p>
          <ul class="ai-condition-grades__list-{{ ai_gen_id }}">
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Noticeable scratches, scuffs, or dents on body</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Screen may have light scratches but remains fully usable</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Maximum value for budget-conscious buyers</li>
            <li class="ai-condition-grades__list-item-{{ ai_gen_id }}">Perfect for those prioritising function over appearance</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="ai-condition-grades__lightbox-{{ ai_gen_id }}" data-lightbox>
    <div class="ai-condition-grades__lightbox-content-{{ ai_gen_id }}">
      <button class="ai-condition-grades__lightbox-close-{{ ai_gen_id }}" aria-label="Close lightbox">×</button>
      <img src="" alt="" class="ai-condition-grades__lightbox-image-{{ ai_gen_id }}">
    </div>
  </div>
</condition-grades-{{ ai_gen_id }}>

<script>
  (function() {
    class ConditionGrades{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.imageWrappers = this.querySelectorAll('.ai-condition-grades__image-wrapper-{{ ai_gen_id }}');
        this.lightbox = this.querySelector('[data-lightbox]');
        this.lightboxImage = this.querySelector('.ai-condition-grades__lightbox-image-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-condition-grades__lightbox-close-{{ ai_gen_id }}');

        this.setupMobileLightbox();
      }

      setupMobileLightbox() {
        if (!this.lightbox || !this.lightboxImage) return;

        this.imageWrappers.forEach((wrapper) => {
          const img = wrapper.querySelector('.ai-condition-grades__image-{{ ai_gen_id }}');
          
          if (!img) return;

          wrapper.addEventListener('click', (e) => {
            if (window.innerWidth <= 989) {
              e.preventDefault();
              const fullSrc = img.getAttribute('data-full-src');
              const alt = img.getAttribute('alt');
              
              this.lightboxImage.src = fullSrc;
              this.lightboxImage.alt = alt;
              this.lightbox.classList.add('active');
              document.body.style.overflow = 'hidden';
            }
          });
        });

        this.closeButton.addEventListener('click', () => {
          this.closeLightbox();
        });

        this.lightbox.addEventListener('click', (e) => {
          if (e.target === this.lightbox) {
            this.closeLightbox();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.lightbox.classList.contains('active')) {
            this.closeLightbox();
          }
        });
      }

      closeLightbox() {
        this.lightbox.classList.remove('active');
        document.body.style.overflow = '';
        this.lightboxImage.src = '';
      }
    }

    customElements.define('condition-grades-{{ ai_gen_id }}', ConditionGrades{{ ai_gen_id }});
  })();
</script>

