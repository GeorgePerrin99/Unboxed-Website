{% doc %}
  @prompt
    I need to add a thin announcment bar for the top of my website that will titles and links to up to 4 pages. Each separated by a vertical line splitter, make the announcement bar thicker than that
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.bar_height }}px 20px;
    text-align: center;
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.link_spacing }}px;
    flex-wrap: wrap;
    max-width: 100%;
  }

  .ai-announcement-bar__link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ai-announcement-bar__link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-announcement-bar__divider-{{ ai_gen_id }} {
    width: 1px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__container-{{ ai_gen_id }} {
      gap: {{ block.settings.link_spacing | times: 0.7 }}px;
    }

    .ai-announcement-bar__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar__container-{{ ai_gen_id }}">
    {% liquid
      assign link_count = 0
      for i in (1..4)
        assign page_key = 'page_' | append: i
        assign title_key = 'link_title_' | append: i
        assign page = block.settings[page_key]
        assign title = block.settings[title_key]
        
        if page != blank and title != blank
          assign link_count = link_count | plus: 1
        endif
      endfor
    %}

    {% for i in (1..4) %}
      {% liquid
        assign page_key = 'page_' | append: i
        assign title_key = 'link_title_' | append: i
        assign page = block.settings[page_key]
        assign title = block.settings[title_key]
      %}

      {% if page != blank and title != blank %}
        <a
          href="{{ page.url }}"
          class="ai-announcement-bar__link-{{ ai_gen_id }}"
        >
          {{ title }}
        </a>

        {% unless forloop.last %}
          {% liquid
            assign remaining_links = 0
            assign next_index = i | plus: 1
            for j in (next_index..4)
              assign next_page_key = 'page_' | append: j
              assign next_title_key = 'link_title_' | append: j
              assign next_page = block.settings[next_page_key]
              assign next_title = block.settings[next_title_key]
              
              if next_page != blank and next_title != blank
                assign remaining_links = remaining_links | plus: 1
              endif
            endfor
          %}

          {% if remaining_links > 0 %}
            <div class="ai-announcement-bar__divider-{{ ai_gen_id }}"></div>
          {% endif %}
        {% endunless %}
      {% endif %}
    {% endfor %}
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Link 1"
    },
    {
      "type": "text",
      "id": "link_title_1",
      "label": "Link text",
      "default": "New Arrivals"
    },
    {
      "type": "page",
      "id": "page_1",
      "label": "Page"
    },
    {
      "type": "header",
      "content": "Link 2"
    },
    {
      "type": "text",
      "id": "link_title_2",
      "label": "Link text",
      "default": "Best Sellers"
    },
    {
      "type": "page",
      "id": "page_2",
      "label": "Page"
    },
    {
      "type": "header",
      "content": "Link 3"
    },
    {
      "type": "text",
      "id": "link_title_3",
      "label": "Link text",
      "default": "Sale"
    },
    {
      "type": "page",
      "id": "page_3",
      "label": "Page"
    },
    {
      "type": "header",
      "content": "Link 4"
    },
    {
      "type": "text",
      "id": "link_title_4",
      "label": "Link text",
      "default": "Contact Us"
    },
    {
      "type": "page",
      "id": "page_4",
      "label": "Page"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 8,
