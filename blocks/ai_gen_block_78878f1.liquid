{% doc %}
  @prompt
    I want to create a collection banner which will be at the top of each of my collection pages. I would like a banner that is the width of my other items on my page and that sits slightly under the header and also has curved corners. I need to put a title and a description in the box and also change the colour of the text or box, the collection title needs to be linked to the collection that is on the page, I should only be able to add a description. The collection title should automatically be the collection that this page is for based. For example this page is currently for the iphones collection. Remove the title option and make the title automatic to whatever collection is on the page, The desciption also should just be the description in collection. Not a custom description. Please remove this option and make it so the description is automatically pulled from the collection itself, finally add in the ability to customise the font in here 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-collection-banner-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }

  .ai-collection-banner-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    margin-top: {{ block.settings.top_spacing }}px;
  }

  .ai-collection-banner-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-collection-banner-title-link-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-collection-banner-title-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-collection-banner-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-style: {{ block.settings.description_font.style }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-collection-banner-description-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
  .ai-collection-banner-title-{{ ai_gen_id }} {
    white-space: nowrap;
  }

    }

    .ai-collection-banner-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-collection-banner-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-banner-content-{{ ai_gen_id }}">
    {% if collection %}
    <h2 class="ai-collection-banner-title-{{ ai_gen_id }}" data-fit-title>

        <a href="{{ collection.url }}" class="ai-collection-banner-title-link-{{ ai_gen_id }}">
          {{ collection.title }}
        </a>
      </h2>

      {% if collection.description != blank %}
        <div class="ai-collection-banner-description-{{ ai_gen_id }}">
          {{ collection.description }}
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<script>
  (function () {
    function fitTitle() {
      if (!window.matchMedia('(max-width: 749px)').matches) return;

      var banner = document.querySelector('.ai-collection-banner-{{ ai_gen_id }}');
      if (!banner) return;

      var title = banner.querySelector('[data-fit-title]');
      if (!title) return;

      // start at normal size
      var maxPx = {{ block.settings.title_size | json }};
      var minPx = 20; // adjust if needed (e.g. 22)
      title.style.fontSize = maxPx + 'px';

      // available width is the title element width
      var available = title.clientWidth;

      // shrink until it fits (one line) or hits min
      var px = maxPx;
      while (px > minPx && title.scrollWidth > available) {
        px -= 1;
        title.style.fontSize = px + 'px';
      }
    }

    function run() { window.requestAnimationFrame(fitTitle); }

    window.addEventListener('resize', run, { passive: true });
    run();
  })();
</script>



