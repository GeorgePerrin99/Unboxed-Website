          "type": "faq",
          "settings": {
            "question": "Is your refurbished jewellery authentic?",
            "answer": "<p>We review hallmarking, materials and key identifying details before a piece is approved for sale, so customers can shop with more confidence.</p>",
            "open_by_default": false
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Do you grade jewellery like tech?",
            "answer": "<p>No. Jewellery is handled as individual pieces rather than grouped into Fair, Good or Like New grades. The product page shows the exact item, presentation and details you are buying.</p>",
            "open_by_default": false
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "What checks are carried out before jewellery goes live?",
            "answer": "<p>We review authenticity, finish, wear points and general presentation. Where relevant, clasps, settings, links and other structural details are checked before sale.</p>",
            "open_by_default": false
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Will I receive the exact jewellery piece shown?",
            "answer": "<p>Yes. Jewellery listings are intended to show the individual piece customers are buying, rather than a generic condition grade example.</p>",
            "open_by_default": false
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Do jewellery orders come with support and returns?",
            "answer": "<p>Yes. Orders include support and a clear returns process so customers can shop with confidence. Any warranty or returns details are available on the relevant policy pages.</p>",
            "open_by_default": false
          }
        }
