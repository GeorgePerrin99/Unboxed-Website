{%- capture link_quick_search -%}
    {{ routes.search_url }}?type=product&q=
  {%- endcapture -%}

{%- liquid
  assign quick_search_source = settings.search_quick_links
  if quick_search_source == blank
    assign quick_search_source = "iPhones,Samsung Galaxy,Rings,Necklaces,Laptops,Gaming,Smartwatches,Bracelets"
  endif
-%}

{%- if quick_search_source != blank -%}
    <div class="predictive-search__heading quick-search-tag-info">
      <div class="quick-search-inner">
        <p>{{- 'wbcustomlabel.wballtext.trendnow' | t -}}</p>
        <ul>
          {%- assign quick_search = quick_search_source | replace: ' ,', ',' | replace: ', ', ',' | split: ',' -%}
          {%- for qr in quick_search -%}
            {%- assign quick_text = qr | strip -%}
            {%- if quick_text -%}
            <li><a class="quick-url link" href="{{ link_quick_search }}{{ quick_text | url_encode }}">{{ quick_text }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
{%- endif -%}
